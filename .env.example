# Which domain the app shows: the id of a file in src/domains (example until you add yours)
NEXT_PUBLIC_DOMAIN=example

# Free key: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

# To switch provider, change AI_PROVIDER + AI_MODEL and fill the matching key
# AI_PROVIDER=groq        (AI_MODEL from console.groq.com/docs/models)
# AI_PROVIDER=openai      (AI_MODEL from platform.openai.com/docs/models)
# AI_PROVIDER=anthropic   (AI_MODEL from docs.claude.com/en/docs/about-claude/models)
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Any OpenAI-compatible service (OpenRouter, Ollama, ...): set AI_PROVIDER=openai and this URL
# AI_BASE_URL=https://openrouter.ai/api/v1

# Saves AI answers in .ai-cache so repeat demos are instant and work offline. Set to off to disable.
AI_CACHE=on

# Seconds to wait for the AI before analysis and summary fall back to built-in rules. Photo extraction gets twice as long.
AI_TIME_LIMIT=25
